# Copy to .env (gitignored). Never commit real values.
OPENROUTER_API_KEY=
# Refresh gate: with neither set, live refresh is disabled (fails closed). Codes must be >= 8 chars.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(12))"
REFRESH_MASTER_CODE=
# Comma-separated; rotate by editing and restarting. Shared quota: 2 refreshes / rolling 3 days.
REFRESH_ACCESS_CODES=
# Production: set false, set your site origin, and point MACRO_LOG_ROOT at persistent storage
# (the quota file lives there; ephemeral disks reset the quota on every deploy).
DEV_TRUST_LOCALHOST_AUTH=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MACRO_LOG_ROOT=
